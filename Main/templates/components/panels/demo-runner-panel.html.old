<!-- Demo Runner Panel -->
<div id="demo-runner-panel" class="panel">
  <div class="panel__header panel__header--amber">
    <div class="panel__icon">
      <i data-lucide="clapperboard" class="w-6 h-6"></i>
    </div>
    <div class="panel__title-group">
      <h2 class="panel__title">Demo Runner</h2>
      <p class="panel__subtitle">Run, load, or create demos</p>
    </div>
    <button class="panel__close">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
  </div>

  <!-- Main Tab -->
  <div id="demo-runner-tab-main" class="space-y-4 panel__body">
    <!-- Quick Actions -->
    <div class="grid grid-cols-3 gap-3">
      <button onclick="DemoRunner.openRandomSettings()" class="btn btn--warning btn--lg flex-col gap-2 py-4">
        <i data-lucide="shuffle" class="w-6 h-6"></i>
        <span class="text-sm font-semibold">Random Demo</span>
      </button>
      <button data-panel="demo-creator" class="btn btn--primary btn--lg flex-col gap-2 py-4">
        <i data-lucide="sparkles" class="w-6 h-6"></i>
        <span class="text-sm font-semibold">Custom Demo</span>
      </button>
      <button onclick="DemoRunner.openExperimentSettings()" class="btn btn--danger btn--lg flex-col gap-2 py-4">
        <i data-lucide="flask-conical" class="w-6 h-6"></i>
        <span class="text-sm font-semibold">Experiment Mode</span>
      </button>
    </div>

    <!-- Tab Navigation for Configurations/Results -->
    <div class="tab-card">
      <div class="tab-card__header">
        <div class="tab-card__nav tabs tabs--pills">
          <div class="tabs__list">
            <button id="tab-btn-configs" onclick="DemoRunner.switchDataTab('configs')" class="tabs__tab"
              aria-selected="true" data-demo-tab="configs" data-color="blue">
              <i data-lucide="save" class="w-4 h-4"></i> Configurations
              <span id="tab-badge-configs" class="tabs__tab-badge">0</span>
            </button>
            <button id="tab-btn-saved-results" onclick="DemoRunner.switchDataTab('saved-results')" class="tabs__tab"
              data-demo-tab="saved-results" data-color="blue">
              <i data-lucide="bar-chart-3" class="w-4 h-4"></i> Saved Results
              <span id="tab-badge-results" class="tabs__tab-badge">0</span>
            </button>
          </div>
        </div>
      </div>

      <div class="tab-card__body">
        <!-- Tab Content: Configurations -->
        <div id="data-tab-configs">
          <div id="saved-configs-list" class="space-y-3"></div>
        </div>

        <!-- Tab Content: Saved Results -->
        <div id="data-tab-saved-results" class="hidden">
          <div class="flex items-center justify-end gap-2 mb-3">
            <button onclick="DemoRunner.importResultsFromFile()" class="btn btn--ghost btn--sm">
              <i data-lucide="upload" class="w-4 h-4"></i>
              Import
            </button>
            <button onclick="DemoRunner.refreshSavedResults()" class="btn btn--ghost btn--sm">
              <i data-lucide="refresh-cw" class="w-4 h-4"></i>
              Refresh
            </button>
          </div>
          <div id="saved-results-list" class="space-y-3">
            <p class="text-muted text-center py-4">Loading saved results...</p>
          </div>
        </div>
      </div>
    </div>
  </div>



  <!-- Experiment Settings Tab -->
  <div id="demo-runner-tab-experiment-settings" class="hidden panel__body space-y-4">
    <button onclick="DemoRunner.showTab('main')" class="btn btn--ghost btn--sm">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      Back
    </button>

    <div class="section-card__header">
      <div class="section-card__icon section-card__icon--danger">
        <i data-lucide="flask-conical" class="w-5 h-5"></i>
      </div>
      <h3 class="section-card__title">Experiment Mode</h3>
    </div>

    <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-xs text-red-800">
      <p class="font-bold mb-1">⚠️ Fixed Experiment Parameters</p>
      <ul class="list-disc list-inside space-y-1">
        <li><strong>3 Trials</strong> - Each configuration tested 3 times</li>
        <li><strong>3 Batches per Trial</strong> - Sequential update batches</li>
        <li><strong>1,000 Disruptions per Batch</strong> - Total 3,000 per trial</li>
        <li><strong>1,000 Queries per Batch</strong> - Total 3,000 queries per trial</li>
        <li><strong>Both Algorithms</strong> - DHL & HC2L compared</li>
      </ul>
    </div>

    <!-- Query Configuration -->
    <div class="section-card section-card--info">
      <div class="section-card__header">
        <div class="section-card__icon section-card__icon--info">
          <i data-lucide="map-pin" class="w-5 h-5"></i>
        </div>
        <h4 class="section-card__title">Query Configuration</h4>
      </div>
      <div class="section-card__body space-y-3">
        <div class="form-group">
          <label class="form-group__label">Route Generation Mode</label>
          <div class="nav-select nav-select--grid">
            <label class="nav-select__option" data-color="blue">
              <input type="radio" name="experiment-route-mode" value="preset" checked>
              <div class="nav-select__icon"><i data-lucide="save" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Preset</span>
                <span class="nav-select__description">Use saved or generate once</span>
              </div>
            </label>
            <label class="nav-select__option" data-color="amber">
              <input type="radio" name="experiment-route-mode" value="random">
              <div class="nav-select__icon"><i data-lucide="shuffle" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Random</span>
                <span class="nav-select__description">New routes every run</span>
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Disruption Configuration -->
    <div class="section-card section-card--warning">
      <div class="section-card__header">
        <div class="section-card__icon section-card__icon--warning">
          <i data-lucide="traffic-cone" class="w-5 h-5"></i>
        </div>
        <h4 class="section-card__title">Disruption Configuration</h4>
      </div>
      <div class="section-card__body space-y-4">
        <div class="form-group">
          <label class="form-group__label">Disruption Generation Mode</label>
          <div class="nav-select nav-select--grid">
            <label class="nav-select__option" data-color="amber">
              <input type="radio" name="experiment-disruption-mode" value="preset" checked>
              <div class="nav-select__icon"><i data-lucide="save" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Preset</span>
                <span class="nav-select__description">Use saved or generate once</span>
              </div>
            </label>
            <label class="nav-select__option" data-color="orange">
              <input type="radio" name="experiment-disruption-mode" value="random">
              <div class="nav-select__icon"><i data-lucide="shuffle" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Random</span>
                <span class="nav-select__description">New disruptions every run</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Severity Range -->
        <div class="border-t border-amber-200 pt-3">
          <h5 class="form-group__label">Severity Range</h5>
          <div class="grid grid-cols-2 gap-3">
            <div class="form-group">
              <label class="form-group__label text-sm">Min Severity</label>
              <div class="flex items-center gap-2">
                <input type="range" id="experiment-severity-min" min="0" max="0.9" step="0.1" value="0.1"
                  oninput="document.getElementById('experiment-severity-min-display').textContent = this.value"
                  class="form-range flex-1">
                <span id="experiment-severity-min-display" class="badge badge--warning w-8">0.1</span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-group__label text-sm">Max Severity</label>
              <div class="flex items-center gap-2">
                <input type="range" id="experiment-severity-max" min="0.1" max="1" step="0.1" value="0.9"
                  oninput="document.getElementById('experiment-severity-max-display').textContent = this.value"
                  class="form-range flex-1">
                <span id="experiment-severity-max-display" class="badge badge--warning w-8">0.9</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Flow:Incident Ratio -->
        <div class="border-t border-amber-200 pt-3">
          <h5 class="form-group__label">Flow : Incident Ratio</h5>
          <div class="flex items-center gap-3">
            <div class="flex-1">
              <label class="form-group__label text-xs text-amber-700">Flow %</label>
              <input type="number" id="experiment-ratio-flow" value="95" min="0" max="100" 
                onchange="document.getElementById('experiment-ratio-incident').value = 100 - this.value"
                class="form-input text-center font-semibold">
            </div>
            <span class="text-gray-400 font-bold text-xl pt-4">:</span>
            <div class="flex-1">
              <label class="form-group__label text-xs text-orange-700">Incident %</label>
              <input type="number" id="experiment-ratio-incident" value="5" min="0" max="100"
                onchange="document.getElementById('experiment-ratio-flow').value = 100 - this.value"
                class="form-input text-center font-semibold">
            </div>
          </div>
          <p class="text-xs text-muted mt-1">Total: 1,000 disruptions (950 flow + 50 incidents at 95:5)</p>
        </div>
      </div>
    </div>

    <!-- TAU (τ) Settings - Copied from Demo Creator -->
    <div class="section-card section-card--purple">
      <div class="section-card__header">
        <div class="section-card__icon section-card__icon--purple">
          <i data-lucide="sliders" class="w-5 h-5"></i>
        </div>
        <h4 class="section-card__title">Threshold (τ) Settings</h4>
      </div>
      <div class="section-card__body space-y-4">
        <!-- TAU Scope -->
        <div>
          <label class="form-group__label mb-3">TAU (τ) Scope</label>
          <div class="nav-select nav-select--purple">
            <label class="nav-select__option tau-scope-option" data-color="purple">
              <input type="radio" name="experiment-tau-scope" value="all" onchange="DemoRunner.updateExperimentTauUI()">
              <div class="nav-select__icon"><i data-lucide="globe" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Same for All</span>
                <span class="nav-select__description">All routes use the same TAU</span>
              </div>
            </label>
            <label class="nav-select__option tau-scope-option" data-color="indigo">
              <input type="radio" name="experiment-tau-scope" value="per-trial" onchange="DemoRunner.updateExperimentTauUI()">
              <div class="nav-select__icon"><i data-lucide="repeat" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Per Trial</span>
                <span class="nav-select__description">Each trial gets unique TAU</span>
              </div>
            </label>
            <label class="nav-select__option tau-scope-option" data-color="teal">
              <input type="radio" name="experiment-tau-scope" value="per-route" onchange="DemoRunner.updateExperimentTauUI()">
              <div class="nav-select__icon"><i data-lucide="git-branch" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Per Route</span>
                <span class="nav-select__description">Each route gets unique TAU</span>
              </div>
            </label>
            <label class="nav-select__option tau-scope-option" data-color="slate">
              <input type="radio" name="experiment-tau-scope" value="per-trial-route" checked onchange="DemoRunner.updateExperimentTauUI()">
              <div class="nav-select__icon"><i data-lucide="shuffle" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Per Trial & Route</span>
                <span class="nav-select__description">Unique TAU for each combination</span>
              </div>
            </label>
          </div>
        </div>

        <!-- TAU Value Input Mode -->
        <div class="border-t border-purple-200 pt-3">
          <label class="form-group__label mb-3">Value Input Mode</label>
          <div class="nav-select nav-select--grid">
            <label class="nav-select__option tau-mode-option" data-color="indigo">
              <input type="radio" name="experiment-tau-mode" value="fixed" onchange="DemoRunner.updateExperimentTauUI()">
              <div class="nav-select__icon"><i data-lucide="crosshair" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Fixed</span>
              </div>
            </label>
            <label class="nav-select__option tau-mode-option" data-color="amber">
              <input type="radio" name="experiment-tau-mode" value="random" checked onchange="DemoRunner.updateExperimentTauUI()">
              <div class="nav-select__icon"><i data-lucide="dice-5" class="w-4 h-4"></i></div>
              <div class="nav-select__content">
                <span class="nav-select__title">Random</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Fixed TAU Input -->
        <div id="experiment-tau-fixed-setting" class="hidden border-t border-purple-200 pt-3">
          <label class="form-group__label">Fixed TAU Value (0.0 - 1.0)</label>
          <input type="number" id="experiment-tau-fixed-value" value="0.5" min="0" max="1" step="0.1" class="form-input">
        </div>

        <!-- Random TAU Range -->
        <div id="experiment-tau-random-setting" class="border-t border-purple-200 pt-3">
          <label class="form-group__label">Random TAU Range</label>
          <div class="grid grid-cols-2 gap-3">
            <div class="form-group">
              <label class="form-group__label text-sm">Min</label>
              <div class="flex items-center gap-2">
                <input type="range" id="experiment-tau-random-min" min="0" max="0.9" step="0.1" value="0.1"
                  oninput="document.getElementById('experiment-tau-min-display').textContent = this.value"
                  class="form-range flex-1">
                <span id="experiment-tau-min-display" class="badge badge--purple w-8">0.1</span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-group__label text-sm">Max</label>
              <div class="flex items-center gap-2">
                <input type="range" id="experiment-tau-random-max" min="0.1" max="1" step="0.1" value="0.9"
                  oninput="document.getElementById('experiment-tau-max-display').textContent = this.value"
                  class="form-range flex-1">
                <span id="experiment-tau-max-display" class="badge badge--purple w-8">0.9</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Experiment Action Buttons -->
  <div id="demo-runner-footer-experiment-settings" class="hidden panel__footer">
    <button onclick="DemoRunner.startExperiment()" class="btn btn--danger btn--lg btn--block">
      <i data-lucide="play" class="w-5 h-5"></i> Start Experiment
    </button>
  </div>

  <!-- Random Settings Tab -->
  <div id="demo-runner-tab-random-settings" class="hidden panel__body space-y-4">
    <button onclick="DemoRunner.showTab('main')" class="btn btn--ghost btn--sm">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      Back
    </button>

    <div class="section-card__header">
      <div class="section-card__icon section-card__icon--amber">
        <i data-lucide="shuffle" class="w-5 h-5"></i>
      </div>
      <h3 class="section-card__title">Random Demo Settings</h3>
    </div>

    <!-- Number of Trials -->
    <div class="section-card section-card--info">
      <div class="form-group">
        <label class="form-group__label"><i data-lucide="repeat" class="w-4 h-4 inline"></i> Number of Trials</label>
        <input type="number" id="random-trials-count" value="1" min="1" max="100" class="form-input">
        <span class="form-group__help">Times to repeat the entire demo</span>
      </div>
    </div>

    <!-- Route Count -->
    <div class="form-group">
      <label class="form-group__label">Number of Routes</label>
      <input type="number" id="random-route-count" value="1" min="1" max="10" class="form-input">
    </div>

    <!-- Algorithm -->
    <div class="form-group">
      <label class="form-group__label">Algorithm</label>
      <select id="random-algorithm" class="form-select">
        <option value="both">Both (HC2L & DHL)</option>
        <option value="hc2l">HC2L Only</option>
        <option value="dhl">DHL Only</option>
      </select>
    </div>

    <!-- TAU Mode -->
    <div class="form-group">
      <label class="form-group__label">TAU (τ) Mode</label>
      <select id="random-tau-mode" class="form-select mb-3">
        <option value="fixed">Fixed Value</option>
        <option value="random">Random</option>
        <option value="sequence">Test Sequence</option>
      </select>

      <div id="tau-fixed-container">
        <input type="number" id="random-tau-fixed" value="0.5" min="0" max="1" step="0.1" class="form-input">
      </div>
      <div id="tau-random-container" class="hidden grid grid-cols-2 gap-2">
        <input type="number" id="random-tau-min" value="0.1" min="0" max="1" step="0.1" placeholder="Min"
          class="form-input">
        <input type="number" id="random-tau-max" value="0.9" min="0" max="1" step="0.1" placeholder="Max"
          class="form-input">
      </div>
      <div id="tau-sequence-container" class="hidden">
        <input type="text" id="random-tau-sequence" value="0.1, 0.3, 0.5, 0.7, 0.9" class="form-input"
          placeholder="0.1, 0.3, 0.5...">
      </div>
    </div>

    <!-- Disruptions -->
    <div class="form-group">
      <label class="form-group__label">Disruptions</label>
      <select id="random-disruption-mode" class="form-select">
        <option value="both">Flow + Incidents</option>
        <option value="flow">Flow Only</option>
        <option value="incidents">Incidents Only</option>
        <option value="none">No Disruptions</option>
      </select>
    </div>

    <!-- Step Delay -->
    <div class="form-group">
      <label class="form-group__label">Step Delay (ms)</label>
      <input type="number" id="random-step-delay" value="2000" min="500" max="10000" step="500" class="form-input">
    </div>

  </div>

  <!-- Fixed Action Buttons at Bottom -->
  <div id="demo-runner-footer-random-settings" class="hidden panel__footer">
    <button onclick="DemoRunner.startRandomDemo()" class="btn btn--warning btn--lg btn--block">
      <i data-lucide="rocket" class="w-5 h-5"></i> Start Random Demo
    </button>
  </div>



  <!-- Running Tab -->
  <div id="demo-runner-tab-running" class="hidden panel__body overflow-y-auto space-y-3 pb-4">
    <div class="section-card__header">
      <div class="section-card__icon section-card__icon--success">
        <i data-lucide="play" class="w-5 h-5"></i>
      </div>
      <h3 class="section-card__title">Demo Running</h3>
    </div>

    <!-- Disruption Preview Panel -->
    <div class="section-card section-card--warning">
      <div class="section-card__header">
        <div class="section-card__icon section-card__icon--warning">
          <i data-lucide="zap" class="w-5 h-5"></i>
        </div>
        <h3 class="section-card__title">Disruption Display</h3>
      </div>

      <div class="section-card__body">
        <!-- Display Toggles -->
        <div class="flex items-center justify-between gap-4 mb-4 pb-4 border-b border-gray-200">
          <label class="form-switch">
            <input type="checkbox" id="demo-show-incidents" checked onchange="DemoRunner.toggleIncidents(this.checked)"
              class="form-switch__input">
            <span class="form-switch__slider"></span>
            <span class="form-switch__label">Show Incidents</span>
          </label>
          <label class="form-switch">
            <input type="checkbox" id="demo-show-flow" checked onchange="DemoRunner.toggleFlowOverlay(this.checked)"
              class="form-switch__input">
            <span class="form-switch__slider"></span>
            <span class="form-switch__label">Show Flow</span>
          </label>
        </div>

        <!-- Disruption Sets Carousel -->
        <div id="demo-runner-disruption-sets" class="hidden">
          <div class="flex items-center gap-2 mb-2">
            <i data-lucide="package" class="w-4 h-4 text-gray-600"></i>
            <span class="text-xs font-semibold text-gray-700">Disruption Sets</span>
          </div>
          <div id="demo-runner-set-buttons"
            class="disruption-sets-container flex gap-2 overflow-x-auto pb-2 -mx-5 px-5 scrollbar-hide"></div>
        </div>

        <!-- Preview Panel -->
        <div id="demo-runner-disruption-preview"
          class="max-h-48 overflow-y-auto card card--flat p-3 bg-gray-50 border border-gray-200">
          <div class="text-muted text-center py-2 text-sm">No disruptions loaded</div>
        </div>
      </div>
    </div>

    <!-- Detailed Progress Display -->
    <div id="demo-runner-progress-detail" class="space-y-3"></div>
  </div>

  <!-- Loading Animation Overlay (shown while initializing) - covers full panel_body -->
  <div id="demo-runner-loading-overlay" class="hidden" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, 0.5); display: none; align-items: center; justify-content: center; z-index: 120;backdrop-filter: blur(4px);">
    <div style="background: white; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); padding: 32px; display: flex; flex-direction: column; align-items: center; gap: 16px; min-width: 300px;">
      <div style="width: 64px; height: 64px; border: 4px solid #e5e7eb; border-top-color: #3b82f6; border-radius: 50%; animation: spin 1s linear infinite;"></div>
      <div style="text-align: center;">
        <h3 id="demo-loading-title" style="font-size: 18px; font-weight: bold; color: #1f2937; margin-bottom: 8px;">Initializing Demo</h3>
        <p id="demo-loading-status" style="color: #4b5563; font-size: 14px;">Setting up...</p>
      </div>
    </div>
  </div>

  <!-- Fixed Controls at Bottom -->
  <div id="demo-runner-footer-running" class="hidden panel__footer">
    <div class="flex gap-2 w-full">
      <button id="demo-play-pause-btn" onclick="DemoRunner.togglePauseResume()" class="btn btn--warning flex-1">
        <i data-lucide="pause" class="w-4 h-4"></i> Pause
      </button>
      <button onclick="DemoRunner.stopDemo()" class="btn btn--danger flex-1">
        <i data-lucide="square" class="w-4 h-4"></i> Stop
      </button>
    </div>
  </div>



  <!-- Results Tab -->
  <div id="demo-runner-tab-results" class="hidden panel__body overflow-y-auto space-y-4 pb-4">
    <button onclick="DemoRunner.showTab('main')" class="btn btn--ghost btn--sm">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      Back to Main
    </button>

    <!-- Statistics Cards -->
    <div id="demo-results-stats" class="grid space-y-3"></div>

    <!-- Best Performer Highlight -->
    <div id="demo-results-best-performer" class="hidden"></div>

    <!-- Appendix Tabs Section (Only for Experiment Mode) -->
    <div id="demo-appendix-section" class="hidden space-y-4">
      <!-- Tab Navigation -->
      <div class="tab-card">
        <div class="tab-card__header">
          <div class="section-card__icon section-card__icon--primary">
            <i data-lucide="file-text" class="w-5 h-5"></i>
          </div>
          <h3 class="section-card__title">Experiment Appendices</h3>
        </div>
        
        <div class="tab-card__nav tabs tabs--pills">
          <div class="tabs__list">
            <button id="appendix-tab-btn-construction" onclick="DemoRunner.switchAppendixTab('construction')" 
              class="tabs__tab" aria-selected="true" data-appendix-tab="construction" data-color="blue">
              <i data-lucide="hammer" class="w-4 h-4"></i> Construction Phase
            </button>
            <button id="appendix-tab-btn-dynamic" onclick="DemoRunner.switchAppendixTab('dynamic')" 
              class="tabs__tab" data-appendix-tab="dynamic" data-color="green">
              <i data-lucide="activity" class="w-4 h-4"></i> Dynamic Updates
            </button>
            <button id="appendix-tab-btn-query" onclick="DemoRunner.switchAppendixTab('query')" 
              class="tabs__tab" data-appendix-tab="query" data-color="purple">
              <i data-lucide="zap" class="w-4 h-4"></i> Query Performance
            </button>
            <button id="appendix-tab-btn-similarity" onclick="DemoRunner.switchAppendixTab('similarity')" 
              class="tabs__tab" data-appendix-tab="similarity" data-color="amber">
              <i data-lucide="git-compare" class="w-4 h-4"></i> Route Similarity
            </button>
          </div>
        </div>

        <div class="tab-card__body">
          <!-- Appendix 1.1: Initial Construction Performance -->
          <div id="appendix-tab-construction" class="appendix-tab-content">
            <div class="section-card">
              <div class="section-card__header">
                <h4 class="section-card__title">Appendix 1.1: Initial Construction Performance</h4>
                <button onclick="DemoRunner.exportAppendixCSV('construction')" class="btn btn--success btn--sm">
                  <i data-lucide="download" class="w-4 h-4"></i> Export CSV
                </button>
              </div>
              <div id="appendix-construction-content" class="section-card__body overflow-x-auto">
                <p class="text-muted text-center py-4">Loading construction metrics...</p>
              </div>
            </div>
          </div>

          <!-- Appendix 1.2: Dynamic Performance Log -->
          <div id="appendix-tab-dynamic" class="appendix-tab-content hidden">
            <div class="section-card">
              <div class="section-card__header">
                <h4 class="section-card__title">Appendix 1.2: Dynamic Performance Log</h4>
                <button onclick="DemoRunner.exportAppendixCSV('dynamic')" class="btn btn--success btn--sm">
                  <i data-lucide="download" class="w-4 h-4"></i> Export CSV
                </button>
              </div>
              <div id="appendix-dynamic-content" class="section-card__body overflow-x-auto">
                <p class="text-muted text-center py-4">Loading dynamic update metrics...</p>
              </div>
            </div>
          </div>

          <!-- Appendix 1.3: Combined Performance Summary -->
          <div id="appendix-tab-query" class="appendix-tab-content hidden">
            <div class="section-card">
              <div class="section-card__header">
                <h4 class="section-card__title">Appendix 1.3: Combined DHL vs DHC2L Performance Summary</h4>
                <button onclick="DemoRunner.exportAppendixCSV('query')" class="btn btn--success btn--sm">
                  <i data-lucide="download" class="w-4 h-4"></i> Export CSV
                </button>
              </div>
              <div id="appendix-query-content" class="section-card__body overflow-x-auto">
                <p class="text-muted text-center py-4">Loading query performance metrics...</p>
              </div>
            </div>
          </div>

          <!-- Appendix 1.4: Route Similarity Evaluation -->
          <div id="appendix-tab-similarity" class="appendix-tab-content hidden">
            <div class="section-card">
              <div class="section-card__header">
                <h4 class="section-card__title">Appendix 1.4: Route Similarity Evaluation</h4>
                <button onclick="DemoRunner.exportAppendixCSV('similarity')" class="btn btn--success btn--sm">
                  <i data-lucide="download" class="w-4 h-4"></i> Export CSV
                </button>
              </div>
              <div id="appendix-similarity-content" class="section-card__body overflow-x-auto">
                <p class="text-muted text-center py-4">Loading route similarity metrics...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Performance Charts Section -->
    <div id="demo-results-charts" class="space-y-4">
      <!-- Query Time Comparison Chart -->
      <div class="section-card">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--purple">
            <i data-lucide="clock" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Query Time Comparison</h4>
        </div>
        <div class="h-40"><canvas id="chart-query-time-comparison"></canvas></div>
      </div>

      <!-- Labeling Time Comparison Chart -->
      <div class="section-card">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--amber">
            <i data-lucide="tag" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Labeling Time Comparison</h4>
        </div>
        <div class="h-40"><canvas id="chart-labeling-time-comparison"></canvas></div>
      </div>

      <!-- Label Size Comparison Chart -->
      <div class="section-card">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--success">
            <i data-lucide="database" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Label Size Comparison (KB)</h4>
        </div>
        <div class="h-40"><canvas id="chart-label-size-comparison"></canvas></div>
      </div>

      <!-- Process Time Comparison Chart -->
      <div class="section-card">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--primary">
            <i data-lucide="rocket" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Process Time Comparison</h4>
        </div>
        <div class="h-40"><canvas id="chart-process-time"></canvas></div>
      </div>

      <!-- Query Time Trend Chart -->
      <div class="section-card">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--info">
            <i data-lucide="timer" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Query Time Trend</h4>
        </div>
        <div class="h-40"><canvas id="chart-query-time-trend"></canvas></div>
      </div>

      <!-- Performance Radar Chart -->
      <div class="section-card">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--warning">
            <i data-lucide="target" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Performance Radar</h4>
        </div>
        <div class="h-56"><canvas id="chart-performance-radar"></canvas></div>
      </div>
    </div>

    <!-- All Results List -->
    <div class="section-card">
      <div class="section-card__header">
        <div class="section-card__icon section-card__icon--purple">
          <i data-lucide="clipboard-list" class="w-5 h-5"></i>
        </div>
        <h4 class="section-card__title">All Results</h4>
        <span id="demo-results-count" class="badge badge--primary">(0 total)</span>
      </div>
      <div id="demo-results-list" class="space-y-2"></div>
    </div>
  </div>

  <!-- Fixed Action Buttons at Bottom -->
  <div id="demo-runner-footer-results" class="hidden panel__footer">
    <div class="flex gap-3 w-full">
      <button id="btn-save-to-server" onclick="DemoRunner.exportResultsLocally()"
        class="btn btn--primary flex-1 hidden">
        <i data-lucide="save" class="w-4 h-4"></i> Save to Server
      </button>
      <button id="btn-delete-from-server" onclick="DemoRunner.deleteFromServer()" class="btn btn--danger flex-1 hidden">
        <i data-lucide="trash-2" class="w-4 h-4"></i> Delete from Server
      </button>
      <button id="btn-download-json" onclick="DemoRunner.downloadResultsAsFile()"
        class="btn btn--success flex-1 hidden">
        <i data-lucide="download" class="w-4 h-4"></i> Download JSON
      </button>
    </div>
  </div>

  <!-- ============================================================================ -->
  <!-- TEMPLATES AND HIDDEN MODALS -->
  <!-- ============================================================================ -->

  <!-- Stop Confirmation Modal (Hidden by default) -->
  <div id="demo-stop-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-[100] hidden">
    <div class="bg-white rounded-2xl p-6 max-w-md mx-4 shadow-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-amber-100 p-3 rounded-full">
          <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-800">Demo Running</h3>
      </div>
      <p class="text-gray-600 mb-6">A demo is currently running. Do you want to stop it and close?</p>
      <div class="flex gap-3">
        <button id="demo-stop-cancel" class="flex-1 py-2 px-4 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-xl transition-colors">
          Continue Demo
        </button>
        <button id="demo-stop-confirm" class="flex-1 py-2 px-4 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-xl transition-colors">
          Stop & Close
        </button>
      </div>
    </div>
  </div>

  <!-- Template: Config Card -->
  <template id="template-config-card">
    <div class="card card--bordered p-4 hover:border-purple-300 hover:shadow-md transition-all">
      <div class="flex items-start justify-between mb-2">
        <div class="flex-1 min-w-0">
          <h4 class="font-bold text-gray-800 truncate" data-config-name></h4>
          <p class="text-xs text-muted" data-config-date></p>
        </div>
        <div class="flex gap-1">
          <button data-config-edit class="btn btn--ghost btn--sm p-1.5" title="Edit">
            <i data-lucide="pencil" class="w-4 h-4 text-blue-500"></i>
          </button>
          <button data-config-delete class="btn btn--ghost btn--sm p-1.5" title="Delete">
            <i data-lucide="x" class="w-4 h-4 text-red-500"></i>
          </button>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <span class="badge badge--info" data-config-routes></span>
        <span class="badge badge--purple" data-config-trials></span>
        <span class="badge badge--warning" data-config-algorithm></span>
      </div>
      <button data-config-run class="btn btn--primary btn--block">
        <i data-lucide="play" class="w-4 h-4"></i> Run Demo
      </button>
    </div>
  </template>

  <!-- Empty State: No Configs -->
  <template id="template-empty-configs">
    <div class="empty-state text-center py-8">
      <div class="empty-state__icon text-muted mb-2">
        <i data-lucide="folder-open" class="w-12 h-12 mx-auto opacity-50"></i>
      </div>
      <p class="text-sm text-muted">No saved configurations</p>
      <p class="text-xs text-muted mt-1">Create a custom demo to save it here</p>
    </div>
  </template>

  <!-- Empty State: No Results -->
  <template id="template-empty-results">
    <div class="empty-state text-center py-6">
      <div class="empty-state__icon text-muted mb-2">
        <i data-lucide="bar-chart-2" class="w-10 h-10 mx-auto opacity-50"></i>
      </div>
      <p class="text-sm text-muted">No saved results yet</p>
      <p class="text-xs text-muted mt-1">Run a demo and save results to see them here</p>
    </div>
  </template>

  <!-- Progress UI Skeleton -->
  <template id="template-progress-skeleton">
    <div class="space-y-3">
      <!-- Demo Status Card -->
      <div class="section-card section-card--primary">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--primary">
            <i data-lucide="activity" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="section-card__title" id="progress-config-name">Demo</h3>
            <p class="text-xs text-gray-600 mt-1" id="progress-status">Initializing...</p>
          </div>
        </div>
        <div class="section-card__body">
          <div class="flex justify-between mb-3">
            <span class="text-xs font-semibold text-gray-700">Overall Progress</span>
            <span class="text-xs font-bold text-primary" id="progress-percentage">0%</span>
          </div>
          <div class="h-3 bg-gray-200 rounded-full overflow-hidden mb-4">
            <div id="progress-bar" class="h-full bg-gradient-to-r from-blue-400 to-blue-600 transition-all duration-500 ease-out rounded-full" style="width: 2%"></div>
          </div>
          <div class="flex gap-2">
            <div class="flex flex-col items-center p-2 rounded-lg bg-blue-50 border border-blue-200 flex-1">
              <i data-lucide="repeat" class="w-4 h-4 text-blue-600 mb-1"></i>
              <div class="text-sm text-blue-600 font-semibold uppercase">Trial</div>
              <div class="text-lg font-bold text-blue-800" id="progress-trial">0/0</div>
            </div>
            <div class="flex flex-col items-center p-2 rounded-lg bg-emerald-50 border border-emerald-200 flex-1">
              <i data-lucide="navigation" class="w-4 h-4 text-emerald-600 mb-1"></i>
              <div class="text-sm text-emerald-600 font-semibold uppercase">Route</div>
              <div class="text-lg font-bold text-emerald-800" id="progress-route">0/0</div>
            </div>
            <div class="flex flex-col items-center p-2 rounded-lg bg-violet-50 border border-violet-200 flex-1">
              <i data-lucide="cpu" class="w-4 h-4 text-violet-600 mb-1"></i>
              <div class="text-sm text-violet-600 font-semibold uppercase">Algorithm</div>
              <div class="text-lg font-bold text-violet-800" id="progress-algorithm">-</div>
            </div>
            <div id="progress-tau-container" class="flex flex-col items-center p-2 rounded-lg bg-rose-50 border border-rose-200 flex-1">
              <i data-lucide="sliders" class="w-4 h-4 text-rose-600 mb-1"></i>
              <div class="text-sm text-rose-600 font-semibold uppercase">Threshold</div>
              <div class="text-lg font-bold text-rose-800" id="progress-tau">-</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Last Result Card (hidden by default) -->
      <div id="progress-last-result" class="section-card section-card--slate hidden">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--success">
            <i data-lucide="check-circle-2" class="w-5 h-5"></i>
          </div>
          <div>
            <h4 class="section-card__title">Last Result</h4>
            <p class="text-xs text-gray-600 mt-1" id="last-result-route"></p>
          </div>
        </div>
        <div class="section-card__body">
          <div class="grid grid-cols-2 gap-2" id="last-result-metrics"></div>
        </div>
      </div>

      <!-- Results History Card (hidden by default) -->
      <div id="progress-results-history" class="section-card section-card--primary hidden">
        <div class="section-card__header">
          <div class="section-card__icon section-card__icon--primary">
            <i data-lucide="history" class="w-5 h-5"></i>
          </div>
          <h4 class="section-card__title">Results History</h4>
          <span class="badge badge--primary" id="progress-history-count">0 total</span>
        </div>
        <div class="section-card__body">
          <div class="space-y-2" id="progress-history-list"></div>
        </div>
      </div>
    </div>
  </template>

  <!-- Template: Result Group Container -->
  <template id="template-result-group">
    <div class="mb-4">
      <div class="flex items-center gap-2 mb-2 pb-1 border-b border-gray-200">
        <i data-lucide="folder" class="w-4 h-4 text-muted"></i>
        <span class="text-sm font-semibold" data-group-name>Unknown Demo</span>
        <span class="badge badge--secondary badge--sm" data-result-count>0 runs</span>
      </div>
      <div class="space-y-2 pl-2" data-results-container></div>
    </div>
  </template>

  <!-- Template: Saved Result Card -->
  <template id="template-saved-result-card">
    <div class="card card--flat p-3 hover:border-indigo-300 hover:bg-indigo-50/30 transition-all cursor-pointer">
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-muted" data-save-date>Unknown Date</span>
        <span class="badge badge--info badge--sm" data-route-count>0 routes</span>
      </div>
      <div class="flex flex-wrap gap-2 text-xs">
        <span class="badge badge--primary badge--sm" data-trials-badge style="display: none;">
          <i data-lucide="repeat" class="w-3 h-3 inline"></i>
          <span data-trials-count>0</span>
        </span>
        <span class="badge badge--purple badge--sm">
          <i data-lucide="clock" class="w-3 h-3 inline"></i>
          <span data-duration>--</span>
        </span>
        <span class="badge badge--warning badge--sm">
          <i data-lucide="zap" class="w-3 h-3 inline"></i>
          <span data-process-time>--</span>
        </span>
        <span class="badge badge--secondary badge--sm" data-algo-badge style="display: none;">
          <span data-algo-breakdown></span>
        </span>
      </div>
    </div>
  </template>

  <!-- Template: Empty Saved Results State -->
  <template id="template-empty-saved-results">
    <div class="empty-state text-center py-6">
      <div class="empty-state__icon text-muted mb-2">
        <i data-lucide="bar-chart-2" class="w-10 h-10 mx-auto opacity-50"></i>
      </div>
      <p class="text-sm text-muted">No saved results yet</p>
      <p class="text-xs text-muted mt-1">Run a demo and save results to see them here</p>
    </div>
  </template>

  <!-- Template: Flow Disruption Item -->
  <template id="template-flow-disruption">
    <div class="flex items-center justify-between bg-orange-50 rounded-lg px-3 py-2 text-xs cursor-pointer hover:bg-orange-100 border border-orange-200 transition-colors">
      <div class="flex items-center gap-2 flex-1 min-w-0">
        <i data-lucide="car" class="w-3 h-3 text-orange-600 flex-shrink-0"></i>
        <span class="truncate text-gray-700" data-road-name>Unknown Road</span>
      </div>
      <span class="font-semibold ml-2 flex-shrink-0" data-jam-factor>JF: 0.0</span>
    </div>
  </template>

  <!-- Template: Incident Disruption Item -->
  <template id="template-incident-disruption">
    <div class="flex items-center justify-between bg-red-50 rounded-lg px-3 py-2 text-xs cursor-pointer hover:bg-red-100 border border-red-200 transition-colors">
      <div class="flex items-center gap-2 flex-1 min-w-0">
        <i data-lucide="zap" class="w-3 h-3 text-red-600 flex-shrink-0"></i>
        <span class="truncate text-gray-700" data-road-name>Unknown Road</span>
      </div>
      <span class="font-semibold ml-2 flex-shrink-0" data-incident-type>Incident</span>
    </div>
  </template>

  <!-- Template: No Disruptions State -->
  <template id="template-no-disruptions">
    <div class="text-xs text-gray-500 text-center py-2">No disruptions loaded</div>
  </template>

  <!-- Template: Result Item Card (Expandable) -->
  <template id="template-result-item">
    <div class="bg-gray-50 rounded-lg border border-gray-200 overflow-hidden result-item">
      <!-- Header (clickable to expand) -->
      <div class="p-3 cursor-pointer hover:bg-gray-100 transition-colors flex justify-between items-center result-header">
        <div class="flex items-center gap-2">
          <span class="text-lg result-algo-icon"></span>
          <span class="font-medium text-gray-800" data-result-title>#1 Algorithm</span>
          <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded result-tau-badge" style="display: none;">τ = 0.50</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-600 font-medium result-distance">📏 N/A</span>
          <svg class="w-5 h-5 text-gray-400 transform transition-transform result-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>
      
      <!-- Collapsible Details (hidden by default) -->
      <div class="hidden result-details border-t border-gray-200 bg-white p-3">
        <div class="text-xs text-gray-500 mb-2">
          <strong>Route:</strong> <span data-route>N/A</span>
        </div>
        <div class="text-xs text-gray-500 mb-2">
          <strong>Trial:</strong> <span data-trial>N/A</span> | <strong>Timestamp:</strong> <span data-timestamp>N/A</span>
        </div>
        
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Distance</div>
            <div class="font-semibold text-gray-800" data-metric-distance>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">ETA</div>
            <div class="font-semibold text-gray-800" data-metric-eta>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Query Time</div>
            <div class="font-semibold text-gray-800" data-metric-query>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Path Length</div>
            <div class="font-semibold text-gray-800" data-metric-path>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Edge Count</div>
            <div class="font-semibold text-gray-800" data-metric-edges>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Labeling Time</div>
            <div class="font-semibold text-gray-800" data-metric-labeling-time>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Labeling Size</div>
            <div class="font-semibold text-gray-800" data-metric-labeling-size>N/A</div>
          </div>
          <div class="bg-gray-50 rounded p-2">
            <div class="text-gray-500">Disrupted Edges</div>
            <div class="font-semibold text-gray-800" data-metric-disrupted>N/A</div>
          </div>
          <div class="col-span-2 bg-amber-50 rounded p-2 result-time-impact" style="display: none;">
            <div class="text-amber-700">Time Impact</div>
            <div class="font-semibold text-amber-800" data-metric-impact>N/A</div>
          </div>
        </div>
        
        <!-- Update Phase Metrics -->
        <div class="mt-3 bg-amber-50 rounded-lg p-2 border border-amber-200">
          <div class="text-xs font-bold text-amber-700 mb-1 flex items-center gap-1">
            <i data-lucide="refresh-cw" class="w-3 h-3"></i> Update Phase
          </div>
          <div class="grid grid-cols-3 gap-1 text-xs">
            <div class="bg-white/50 rounded p-1">
              <div class="text-amber-600 text-[10px]">Strategy</div>
              <div class="font-semibold text-amber-800" data-update-strategy>N/A</div>
            </div>
            <div class="bg-white/50 rounded p-1">
              <div class="text-amber-600 text-[10px]">Repair Time</div>
              <div class="font-semibold text-amber-800" data-update-repair>N/A</div>
            </div>
            <div class="bg-white/50 rounded p-1">
              <div class="text-amber-600 text-[10px]">Nodes Repaired</div>
              <div class="font-semibold text-amber-800" data-update-nodes>N/A</div>
            </div>
