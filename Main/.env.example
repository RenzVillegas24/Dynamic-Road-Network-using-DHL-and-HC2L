# Environment Configuration for Dynamic Road Network Application
# Copy this file to .env and fill in your actual values

# Google Maps API Key (required for frontend maps)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# HERE API Key (optional - only needed if using real-time traffic data)
# Get your key from: https://developer.here.com/
HERE_API_KEY=your_here_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Data Directory Configuration
# Leave empty to use default paths relative to Main directory
DATA_DIR=

# Algorithm Executables (optional - auto-detected if not set)
DHL_EXECUTABLE=
HC2L_EXECUTABLE=

# Logging
LOG_LEVEL=INFO
